# Скопируйте в .env и подставьте значения. Сам .env в git не попадает.

# --- Клиент (Vite вшивает эти значения в бандл — они публичны by design) ---
# Ключ Supabase защищён политиками RLS, а не секретностью.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Сервер (только для serverless-функций в /api) ---
# Без префикса VITE_, иначе Vite вшил бы токен в бандл и он утёк бы в браузер.
META_ACCESS_TOKEN=

# Ниже — необязательно: если не заданы, функция возьмёт VITE_-переменные выше.
# Эти два значения и так публичны, дублировать их нужно только когда сервер
# должен ходить в другой проект Supabase, чем клиент.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
